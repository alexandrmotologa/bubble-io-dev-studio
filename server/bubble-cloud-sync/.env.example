# Bubble Cloud Sync Engine - Environment Configuration

# Port to listen on (Default: 8080)
PORT=8080

# The session cookie for the collaborator bot account (bot@yourdomain.com)
# Retrieve from browser DevTools: Application -> Cookies -> bubble.io -> bubble_session
BUBBLE_BOT_SESSION=your_bubble_session_cookie_here

# Optional secret token to protect your endpoint from unauthorized use
SYNC_API_SECRET=
